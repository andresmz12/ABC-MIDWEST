# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Set to "true" to enforce SSL certificate verification (recommended in production)
DB_SSL_VERIFY_CERT=false

# ── Auth ───────────────────────────────────────────────────────────────────────
# JWT signing secret — REQUIRED in production. Must be at least 32 random characters.
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-use-a-long-random-string-in-production

# ── App ────────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Cloudinary — file/photo storage ────────────────────────────────────────────
# Required for clock-in photo uploads and document storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Email notifications (optional) ─────────────────────────────────────────────
# SendGrid API key — only required if you use email notifications
SENDGRID_API_KEY=SG.xxxxxxxxxxxx
# Sender address that appears in notification emails
FROM_EMAIL=noreply@yourcompany.com
